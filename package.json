{
  "name": "react-vite-anchor",
  "description": "React + Vite, Tailwind, @solana/react-hooks, Anchor vault program",
  "keywords": [
    "anchor",
    "kit",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "vite"
  ],
  "create-solana-dapp": {
    "rename": {
      "scaffold": {
        "to": "{{name}}",
        "paths": [
          "src"
        ]
      }
    }
  },
  "version": "0.0.0",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "anchor-build": "node scripts/pin-program-key.cjs && cd anchor && anchor build --ignore-keys",
    "anchor-test": "node scripts/pin-program-key.cjs && cd anchor && anchor build --ignore-keys && cargo test",
    "build": "node scripts/bundle-gate.mjs && tsc -b && vite build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "codama:js": "codama run js",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/src/index.ts",
    "server:test": "node --test server/test/gate.test.ts",
    "history:test": "vitest run",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "ofac:refresh": "node --experimental-strip-types scripts/ofac-refresh.ts",
    "ofac:coverage": "node --experimental-strip-types scripts/check-ofac-coverage.ts",
    "providers:verify": "node --experimental-strip-types scripts/pre-verify.ts",
    "providers:warm": "node --experimental-strip-types scripts/warm-cache.ts",
    "setup": "npm run anchor-build && npm run codama:js"
  },
  "dependencies": {
    "@solana/client": "^1.2.0",
    "@solana/kit": "^5.1.0",
    "@solana/react-hooks": "^1.1.5",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4",
    "bs58": "^6.0.0",
    "cookie": "0.7.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sax": "^1.6.1",
    "tailwindcss": "^4",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.3",
    "@codama/renderers-js": "1.7.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.3",
    "codama": "1.10.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6",
    "vitest": "^3.2.7"
  }
}

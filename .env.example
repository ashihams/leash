# Server only. Never prefix the service key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
INTERNAL_API_SECRET=replace-with-a-long-random-string
# 32 bytes, base64. Example generated locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_AUTH_SECRET=
SEED_DEMO_PASSWORD=leash-demo-mock

# Live providers. The server refuses to start when any Didit value is empty.
# OFAC SDN is a public file and needs no key. Optional SHA-256 if you pin a published digest.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_ENVIRONMENT=live
OFAC_SDN_SHA256=
# Optional. Off unless set, and not called during clearance.
RANGE_API_KEY=

# Existing compliance gate.
LEASH_USDC_MINT=
LEASH_POLICY_VERSION=1
PORT=8787

# Frontend. The anon key is public. Do not put the service key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GATE_URL=/gate
